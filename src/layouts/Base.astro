---
import '../styles/global.css';
import { WALINE_SERVER_URL, SITE_URL } from '../lib/config';

const SITE_NAME = '王贺松 · 手搓 Agent 的人';
const DEFAULT_DESC = '王贺松的个人技术主页：手搓 Agent、LangGraph 工程化、拆解 AI Agent 系统底层。';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const { title, description = DEFAULT_DESC, type = 'website', publishedTime } = Astro.props;

const pageTitle = title ? `${title} · 王贺松` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImage = new URL('/og-image.png', SITE_URL).toString();

const nav = [
  { href: '/blog', label: '博客' },
  { href: '/projects', label: '项目' },
  { href: '/about', label: '关于' },
  { href: '/resume', label: '简历' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            name: SITE_NAME,
            url: SITE_URL,
            description: DEFAULT_DESC,
          },
          {
            '@type': 'Person',
            name: '王贺松',
            url: SITE_URL,
            sameAs: ['https://github.com/wanghesong2019'],
          },
        ],
      })}
    />
  </head>

  <body data-waline={WALINE_SERVER_URL}>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href="/">
          <span class="name">王贺松</span>
          <span class="role">手搓 Agent 的人</span>
        </a>
        <nav class="site-nav">
          {
            nav.map((n) => {
              const current =
                Astro.url.pathname === n.href || Astro.url.pathname.startsWith(n.href + '/');
              return (
                <a href={n.href} aria-current={current ? 'page' : undefined}>
                  {n.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        © 2026 王贺松 ·{' '}
        <a href="https://github.com/wanghesong2019" target="_blank" rel="noopener">github.com/wanghesong2019</a>
      </div>
    </footer>

    <script is:inline>
      // 站点总访问量：每页加载时用 Waline 的 pageview 模块递增根路径 "/"
      (function () {
        var serverURL = document.body.getAttribute('data-waline');
        if (!serverURL) return;
        import('https://unpkg.com/@waline/client@v3/dist/pageview.js').then(function (mod) {
          mod.pageviewCount({ serverURL: serverURL, path: '/' });
        });
      })();
    </script>
  </body>
</html>
