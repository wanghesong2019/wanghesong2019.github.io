---
import Base from '../../../layouts/Base.astro';
import { sortedPosts, slugOf, columnName } from '../../../lib/blog';
import { WALINE_SERVER_URL } from '../../../lib/config';

export async function getStaticPaths() {
  const posts = await sortedPosts();
  return posts.map((p, i) => ({
    params: { column: p.data.column, slug: slugOf(p) },
    props: { run: i + 1 },
  }));
}

const { run } = Astro.props;
const { column, slug } = Astro.params;

const posts = await sortedPosts();
const entry = posts.find((p) => p.data.column === column && slugOf(p) === slug);
if (!entry) {
  return Astro.redirect('/blog');
}

// glob loader 的 entry 没有 render()，正文已在同步时预渲染成 entry.rendered.html
const { title, date, description } = entry.data;
const html = entry.rendered?.html ?? '';
const dateStr = date.toISOString().slice(0, 10);
const colName = columnName(column);
const path = `/blog/${column}/${slug}/`;
---

<Base title={title} description={description}>
  <article>
    <header class="post-head">
      <div class="post-meta">
        <span class="run">RUN #{run}</span>
        <span class="col"><a href={`/blog/${column}`}>{colName}</a></span>
        <time datetime={dateStr}>{dateStr}</time>
      </div>
      <h1>{title}</h1>
    </header>

    <div class="post-body" set:html={html} />

    {
      WALINE_SERVER_URL && (
        <footer class="post-footer">
          <div class="post-stats">
            <span>
              浏览 <span class="waline-pageview-count" data-path={path}>0</span>
            </span>
          </div>

          <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
          <div id="waline"></div>

          <script define:vars={{ serverURL: WALINE_SERVER_URL, path }}>
            import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';
            init({
              el: '#waline',
              serverURL,
              path,
              pageview: true,
              comment: true,
              reaction: true,
              lang: 'zh-CN',
              locale: {
                placeholder: '写点什么…（支持匿名，留邮箱可收回复提醒）',
              },
            });
          </script>
        </footer>
      )
    }
  </article>

  <script is:inline>
    // 渲染 mermaid 代码块为图；CDN 不可用时图退化为代码块，不影响阅读
    (function () {
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js';
      s.onload = function () {
        mermaid.initialize({ startOnLoad: false, theme: 'neutral' });
        document.querySelectorAll('pre code.language-mermaid').forEach(function (code) {
          var pre = code.parentElement;
          var div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = code.textContent;
          pre.replaceWith(div);
        });
        mermaid.run({ nodes: document.querySelectorAll('.mermaid') });
      };
      document.head.appendChild(s);
    })();
  </script>
</Base>
